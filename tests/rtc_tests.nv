// rtc_tests — the real-time-clock trait implemented by a driver over
// the I2C double and by a fixed clock that performs nothing; an alarm's
// match; BCD, the 12-hour form, the calendar, the weekday and Unix time.

use std.test
use embedded_hal.{ I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring }
use dev_rtc.{ RtcDateTime, AlarmMatch, RealTimeClock, RealTimeClockAsync }

// ── Doubles ──────────────────────────────────────────────────────────
//
// A trait method's receiver is a plain `self`, so a double cannot
// record its calls.  Each double answers from fixed data instead: the
// I2C double acknowledges one write frame, and the SPI and GPIO doubles
// panic on the one call a test names (`trip`), which
// `test.assert_raises` observes.

// An I2C bus with one device at `addr`.  Register r reads `regs[r]`, and
// a multi-byte read continues through the following registers.  A write
// is acknowledged when it reaches `addr` and its bytes are `expect`.
struct FakeI2c
    addr: Int
    regs: [Int]
    expect: [Int]

impl I2cBus for FakeI2c
    fn init(self, freq: Int) [hw]
        pass

    fn write(self, addr: Int, data: [u8]) -> Bool [hw]
        if addr != self.addr or data.len() != self.expect.len()
            return false
        for i in 0..data.len()
            if (data[i] as Int) != self.expect[i]
                return false
        true

    fn read(self, addr: Int, n: Int) -> ?[u8] [hw]
        if addr != self.addr
            return None
        var out: [u8] = []
        for i in 0..n
            list.push(out, self.regs[i] as u8)
        Some(out)

    fn write_read(self, addr: Int, tx: [u8], n: Int) -> ?[u8] [hw]
        if addr != self.addr
            return None
        let r = tx[0] as Int
        var out: [u8] = []
        for i in 0..n
            list.push(out, self.regs[r + i] as u8)
        Some(out)

// An SPI bus whose reads answer `rx`, from its first byte.  A write
// whose first byte is `trip` panics.
struct FakeSpi
    rx: [Int]
    trip: Int

impl SpiBus for FakeSpi
    fn init(self, freq: Int, mode: Int) [hw]
        pass

    fn transfer(self, b: Int) -> Int [hw]
        self.rx[0]

    fn write(self, data: [u8]) [hw]
        if data.len() > 0 and (data[0] as Int) == self.trip
            panic.panic("spi write")

    fn read(self, n: Int) -> [u8] [hw]
        var out: [u8] = []
        for i in 0..n
            list.push(out, self.rx[i] as u8)
        out

// A GPIO port.  A write of `val` to `pin` panics when pin * 10 + val
// equals `trip`.
struct FakePins
    trip: Int

impl GpioOut for FakePins
    fn mode(self, pin: Int, dir: Int) [hw]
        pass

    fn set(self, pin: Int, val: Int) [hw]
        if pin * 10 + val == self.trip
            panic.panic("gpio set")

    fn get(self, pin: Int) -> Int [hw]
        0

// ── A driver over I2C ────────────────────────────────────────────────
//
// A clock laid out as Analog Devices' DS3231 is: seven BCD registers
// from 0x00, the seconds, minutes, hours, weekday, date, month and
// year.  Bit 6 of the hours selects the 12-hour form, with bit 5 the PM
// bit; bit 7 of the month is the century.  Bit 7 of STATUS (0x0f) is
// the oscillator-stop flag.  Alarm 1 is four registers from 0x07, the
// second, minute, hour and date, and writing 0 to CONTROL (0x0e)
// disarms it.  Bit 7 of each alarm register, A1M1 to A1M4, masks its
// field out of the match: all four set fire each second, A1M1 clear
// alone matches the second, A1M1 and A1M2 clear the minute and the
// second, A1M4 set alone the hour, minute and second, and all clear the
// date as well.

struct Ds
    bus: FakeI2c
    w: DeviceWiring

fn hour_of(b: Int) -> Int
    if (b & 0x40) != 0
        return dev_rtc.rtc_hour_24(dev_rtc.rtc_from_bcd(b & 0x1f), (b & 0x20) != 0)
    dev_rtc.rtc_from_bcd(b & 0x3f)

impl RealTimeClock[hw] for Ds
    fn rtc_now(self) -> ?RtcDateTime [hw]
        match dev_bus.wiring_read(self.bus, self.w, 0x00, 7)
            Some(b) =>
                let century = if (b[5] as Int & 0x80) != 0
                    100
                else
                    0
                Some(RtcDateTime { year: 2000 + century + dev_rtc.rtc_from_bcd(b[6] as Int),
                                   month: dev_rtc.rtc_from_bcd(b[5] as Int & 0x1f),
                                   day: dev_rtc.rtc_from_bcd(b[4] as Int),
                                   hour: hour_of(b[2] as Int),
                                   minute: dev_rtc.rtc_from_bcd(b[1] as Int),
                                   second: dev_rtc.rtc_from_bcd(b[0] as Int) })
            None    => None

    fn rtc_set(self, t: RtcDateTime) -> Bool [hw]
        if not dev_rtc.rtc_is_valid(t) or t.year < 2000 or t.year > 2199
            return false
        let century = if t.year >= 2100
            0x80
        else
            0
        dev_bus.wiring_write(self.bus, self.w, 0x00,
                             [dev_rtc.rtc_to_bcd(t.second) as u8, dev_rtc.rtc_to_bcd(t.minute) as u8,
                              dev_rtc.rtc_to_bcd(t.hour) as u8, dev_rtc.rtc_weekday(t) as u8,
                              dev_rtc.rtc_to_bcd(t.day) as u8, (dev_rtc.rtc_to_bcd(t.month) | century) as u8,
                              dev_rtc.rtc_to_bcd(t.year % 100) as u8])

    fn rtc_running(self) -> Bool [hw]
        match dev_bus.wiring_read(self.bus, self.w, 0x0f, 1)
            Some(b) => (b[0] as Int & 0x80) == 0
            None    => false

    fn rtc_set_alarm(self, t: RtcDateTime) -> Bool [hw]
        if not dev_rtc.rtc_is_valid(t)
            return false
        dev_bus.wiring_write(self.bus, self.w, 0x07,
                             [dev_rtc.rtc_to_bcd(t.second) as u8, dev_rtc.rtc_to_bcd(t.minute) as u8,
                              dev_rtc.rtc_to_bcd(t.hour) as u8, dev_rtc.rtc_to_bcd(t.day) as u8])

    fn rtc_cancel_alarm(self) -> Bool [hw]
        dev_bus.wiring_write(self.bus, self.w, 0x0e, [0 as u8])

    fn rtc_set_alarm_match(self, t: RtcDateTime, m: AlarmMatch) -> Bool [hw]
        if not dev_rtc.rtc_is_valid(t)
            return false
        // The mask bits A1M1 to A1M4, one per register.
        let masks = match m
            AlarmOnce        => [0, 0, 0, 0]
            AlarmEveryDay    => [0, 0, 0, 0x80]
            AlarmEveryHour   => [0, 0, 0x80, 0x80]
            AlarmEveryMinute => [0, 0x80, 0x80, 0x80]
            AlarmEverySecond => [0x80, 0x80, 0x80, 0x80]
        dev_bus.wiring_write(self.bus, self.w, 0x07,
                             [(dev_rtc.rtc_to_bcd(t.second) | masks[0]) as u8,
                              (dev_rtc.rtc_to_bcd(t.minute) | masks[1]) as u8,
                              (dev_rtc.rtc_to_bcd(t.hour) | masks[2]) as u8,
                              (dev_rtc.rtc_to_bcd(t.day) | masks[3]) as u8])

impl RealTimeClockAsync[hw] for Ds
    async fn rtc_alarm_wait(self) -> ?RtcDateTime [hw]
        // The double's alarm has always fired; a part on a scheduler
        // parks here until its interrupt line goes low.
        self.rtc_now_valid()

// 2026-10-06 14:30:59, a Tuesday, in the 24-hour form, with the
// oscillator running unless `stopped`.
fn regs(stopped: Bool) -> [Int]
    var r = list.zeros(16)
    r[0x00] = 0x59
    r[0x01] = 0x30
    r[0x02] = 0x14
    r[0x03] = 2
    r[0x04] = 0x06
    r[0x05] = 0x10
    r[0x06] = 0x26
    r[0x0f] = if stopped
        0x80
    else
        0x00
    r

fn clock(r: [Int], expect: [Int]) -> Ds
    Ds { bus: FakeI2c { addr: 0x68, regs: r, expect: expect }, w: dev_bus.wiring_i2c(0, 0x68) }

fn when(y: Int, mo: Int, d: Int, h: Int, mi: Int, s: Int) -> RtcDateTime
    RtcDateTime { year: y, month: mo, day: d, hour: h, minute: mi, second: s }

@test
fn test_now_decodes_the_bcd_registers() [io, hw]
    match clock(regs(false), []).rtc_now()
        Some(t) =>
            test.assert(t.year == 2026)
            test.assert(t.month == 10)
            test.assert(t.day == 6)
            test.assert(t.hour == 14)
            test.assert(t.minute == 30)
            test.assert(t.second == 59)
        None    => test.assert(false)

@test
fn test_the_12_hour_form_and_the_century_are_read() [io, hw]
    var r = regs(false)
    // 2:30 PM in the 12-hour form, in the next century.
    r[0x02] = 0x40 | 0x20 | 0x02
    r[0x05] = 0x80 | 0x10
    match clock(r, []).rtc_now()
        Some(t) =>
            test.assert(t.hour == 14)
            test.assert(t.year == 2126)
        None    => test.assert(false)

@test
fn test_set_writes_seven_bcd_registers_with_the_weekday() [io, hw]
    let t = when(2026, 10, 6, 14, 30, 59)
    test.assert(clock(regs(false), [0x00, 0x59, 0x30, 0x14, 2, 0x06, 0x10, 0x26]).rtc_set(t))
    // The next century sets the century bit, and 2126-10-06 is a Sunday.
    let later = when(2126, 10, 6, 14, 30, 59)
    test.assert(clock(regs(false), [0x00, 0x59, 0x30, 0x14, 7, 0x06, 0x90, 0x26]).rtc_set(later))

@test
fn test_set_refuses_a_time_the_calendar_or_the_part_does_not_have() [io, hw]
    let c = clock(regs(false), [])
    test.assert(not c.rtc_set(when(2025, 2, 29, 0, 0, 0)))
    test.assert(not c.rtc_set(when(1999, 1, 1, 0, 0, 0)))
    test.assert(not c.rtc_set(when(2200, 1, 1, 0, 0, 0)))

@satisfies(REQ-DEV-005)
@test
fn test_a_stopped_oscillator_makes_the_time_invalid() [io, hw]
    test.assert(clock(regs(false), []).rtc_running())
    test.assert(clock(regs(false), []).rtc_now_valid() != None)
    let stopped = clock(regs(true), [])
    test.assert(not stopped.rtc_running())
    test.assert(stopped.rtc_now_valid() == None)
    // The registers still hold a time; it is the time that is wrong.
    test.assert(stopped.rtc_now() != None)

@satisfies(REQ-DEV-001)
@test
fn test_an_absent_clock_answers_nothing() [io, hw]
    let gone = Ds { bus: FakeI2c { addr: 0x69, regs: regs(false), expect: [] },
        w: dev_bus.wiring_i2c(0, 0x68) }
    test.assert(gone.rtc_now() == None)
    test.assert(not gone.rtc_running())

@test
fn test_the_alarm_is_armed_and_disarmed() [io, hw]
    let t = when(2026, 10, 7, 7, 0, 0)
    test.assert(clock(regs(false), [0x07, 0x00, 0x00, 0x07, 0x07]).rtc_set_alarm(t))
    test.assert(not clock(regs(false), [0x07, 0x00, 0x00, 0x07, 0x07]).rtc_set_alarm(when(2026, 13, 1, 0, 0, 0)))
    test.assert(clock(regs(false), [0x0e, 0x00]).rtc_cancel_alarm())

@satisfies(REQ-DEV-010)
@test
fn test_an_alarm_every_day_at_seven_masks_the_date() [io, hw]
    let t = when(2026, 10, 7, 7, 0, 0)
    test.assert(clock(regs(false), [0x07, 0x00, 0x00, 0x07, 0x87]).rtc_set_alarm_match(t, AlarmEveryDay))
    test.assert(clock(regs(false), [0x07, 0x00, 0x00, 0x07, 0x07]).rtc_set_alarm_match(t, AlarmOnce))
    test.assert(clock(regs(false), [0x07, 0x00, 0x00, 0x87, 0x87]).rtc_set_alarm_match(t, AlarmEveryHour))
    test.assert(clock(regs(false), [0x07, 0x00, 0x80, 0x87, 0x87]).rtc_set_alarm_match(t, AlarmEveryMinute))
    test.assert(clock(regs(false), [0x07, 0x80, 0x80, 0x87, 0x87]).rtc_set_alarm_match(t, AlarmEverySecond))
    test.assert(not clock(regs(false), []).rtc_set_alarm_match(when(2026, 2, 30, 7, 0, 0), AlarmEveryDay))

@satisfies(REQ-DEV-008)
@test
fn test_the_async_form_answers_when_the_alarm_fires() [io, hw, async]
    match await clock(regs(false), []).rtc_alarm_wait()
        Some(t) => test.assert(t.minute == 30)
        None    => test.assert(false)
    test.assert(await clock(regs(true), []).rtc_alarm_wait() == None)

// ── A fixed clock ────────────────────────────────────────────────────

// Noon on New Year's Day 2030, always, performing nothing.
struct Fixed
    hour: Int

impl RealTimeClock[] for Fixed
    fn rtc_now(self) -> ?RtcDateTime
        Some(when(2030, 1, 1, self.hour, 0, 0))

    fn rtc_set(self, t: RtcDateTime) -> Bool
        false

    fn rtc_running(self) -> Bool
        true

    fn rtc_set_alarm(self, t: RtcDateTime) -> Bool
        false

    fn rtc_cancel_alarm(self) -> Bool
        false

fn is_noon<C: RealTimeClock[e]>(c: C) -> Bool [e]
    match c.rtc_now_valid()
        Some(t) => t.hour == 12 and t.minute == 0
        None    => false

@test
fn test_a_fixed_clock_needs_no_hardware()
    test.assert(is_noon(Fixed { hour: 12 }))
    test.assert(not Fixed { hour: 12 }.rtc_set(when(2030, 1, 1, 0, 0, 0)))
    test.assert(not Fixed { hour: 12 }.rtc_set_alarm(when(2030, 1, 1, 0, 0, 0)))
    test.assert(not Fixed { hour: 12 }.rtc_cancel_alarm())

// A clock whose alarm fires once and cannot repeat: the trait's body
// passes the once form to `rtc_set_alarm` and refuses the others.
struct OneShot
    takes: Bool

impl RealTimeClock[] for OneShot
    fn rtc_now(self) -> ?RtcDateTime
        None

    fn rtc_set(self, t: RtcDateTime) -> Bool
        false

    fn rtc_running(self) -> Bool
        false

    fn rtc_set_alarm(self, t: RtcDateTime) -> Bool
        self.takes

    fn rtc_cancel_alarm(self) -> Bool
        true

@satisfies(REQ-DEV-010)
@test
fn test_a_clock_that_cannot_repeat_refuses_a_repeating_alarm()
    let t = when(2030, 1, 1, 7, 0, 0)
    test.assert(OneShot { takes: true }.rtc_set_alarm_match(t, AlarmOnce))
    test.assert(not OneShot { takes: false }.rtc_set_alarm_match(t, AlarmOnce))
    test.assert(not OneShot { takes: true }.rtc_set_alarm_match(t, AlarmEveryDay))
    test.assert(not OneShot { takes: true }.rtc_set_alarm_match(t, AlarmEverySecond))
    test.assert(OneShot { takes: true }.rtc_now_valid() == None)

// ── An alarm's match ─────────────────────────────────────────────────

@satisfies(REQ-DEV-010)
@test
fn test_each_match_compares_its_fields() [io]
    let a = when(2026, 10, 7, 7, 30, 15)
    // The same time matches every form.
    test.assert(dev_rtc.rtc_alarm_matches(a, a, AlarmOnce))
    test.assert(dev_rtc.rtc_alarm_matches(a, a, AlarmEveryDay))
    // Another day at the same time: every form but once.
    let next_day = when(2026, 10, 8, 7, 30, 15)
    test.assert(not dev_rtc.rtc_alarm_matches(next_day, a, AlarmOnce))
    test.assert(dev_rtc.rtc_alarm_matches(next_day, a, AlarmEveryDay))
    test.assert(not dev_rtc.rtc_alarm_matches(when(2026, 11, 7, 7, 30, 15), a, AlarmOnce))
    test.assert(not dev_rtc.rtc_alarm_matches(when(2027, 10, 7, 7, 30, 15), a, AlarmOnce))
    // Another hour: the hourly form and the finer ones.
    let other_hour = when(2026, 10, 7, 9, 30, 15)
    test.assert(not dev_rtc.rtc_alarm_matches(other_hour, a, AlarmEveryDay))
    test.assert(dev_rtc.rtc_alarm_matches(other_hour, a, AlarmEveryHour))
    // Another minute: the minute form and each second.
    let other_minute = when(2026, 10, 7, 9, 31, 15)
    test.assert(not dev_rtc.rtc_alarm_matches(other_minute, a, AlarmEveryHour))
    test.assert(dev_rtc.rtc_alarm_matches(other_minute, a, AlarmEveryMinute))
    let other_second = when(2026, 10, 7, 9, 31, 16)
    test.assert(not dev_rtc.rtc_alarm_matches(other_second, a, AlarmEveryMinute))
    test.assert(dev_rtc.rtc_alarm_matches(other_second, a, AlarmEverySecond))

// ── BCD, the 12-hour form, the calendar and the weekday ──────────────

@test
fn test_bcd_both_ways() [io]
    test.assert(dev_rtc.rtc_from_bcd(0x59) == 59)
    test.assert(dev_rtc.rtc_from_bcd(0x00) == 0)
    test.assert(dev_rtc.rtc_to_bcd(59) == 0x59)
    test.assert(dev_rtc.rtc_to_bcd(7) == 0x07)
    test.assert(dev_rtc.rtc_from_bcd(dev_rtc.rtc_to_bcd(42)) == 42)

@test
fn test_the_12_hour_form() [io]
    test.assert(dev_rtc.rtc_hour_24(12, false) == 0)
    test.assert(dev_rtc.rtc_hour_24(1, false) == 1)
    test.assert(dev_rtc.rtc_hour_24(11, false) == 11)
    test.assert(dev_rtc.rtc_hour_24(12, true) == 12)
    test.assert(dev_rtc.rtc_hour_24(1, true) == 13)
    test.assert(dev_rtc.rtc_hour_24(11, true) == 23)

@test
fn test_leap_years() [io]
    test.assert(dev_rtc.rtc_is_leap_year(2024))
    test.assert(not dev_rtc.rtc_is_leap_year(2026))
    test.assert(not dev_rtc.rtc_is_leap_year(2100))
    test.assert(dev_rtc.rtc_is_leap_year(2000))

@test
fn test_days_in_each_month() [io]
    var total = 0
    for m in 1..13
        total = total + dev_rtc.rtc_days_in_month(2026, m)
    test.assert(total == 365)
    test.assert(dev_rtc.rtc_days_in_month(2024, 2) == 29)
    test.assert(dev_rtc.rtc_days_in_month(2026, 2) == 28)
    test.assert(dev_rtc.rtc_days_in_month(2026, 0) == 0)
    test.assert(dev_rtc.rtc_days_in_month(2026, 13) == 0)

@test
fn test_validity_of_each_field() [io]
    test.assert(dev_rtc.rtc_is_valid(when(2024, 2, 29, 23, 59, 59)))
    test.assert(not dev_rtc.rtc_is_valid(when(2026, 2, 29, 0, 0, 0)))
    test.assert(not dev_rtc.rtc_is_valid(when(2026, 0, 1, 0, 0, 0)))
    test.assert(not dev_rtc.rtc_is_valid(when(2026, 1, 0, 0, 0, 0)))
    test.assert(not dev_rtc.rtc_is_valid(when(2026, 1, 1, 24, 0, 0)))
    test.assert(not dev_rtc.rtc_is_valid(when(2026, 1, 1, 0, 60, 0)))
    test.assert(not dev_rtc.rtc_is_valid(when(2026, 1, 1, 0, 0, 60)))
    test.assert(not dev_rtc.rtc_is_valid(when(2026, 1, 1, -1, 0, 0)))

@satisfies(REQ-DEV-006)
@test
fn test_the_weekday_of_known_dates() [io]
    // 2026-10-06 is a Tuesday, 2000-01-01 a Saturday, 2024-02-29 a
    // Thursday and 2023-01-01 a Sunday.
    test.assert(dev_rtc.rtc_weekday(when(2026, 10, 6, 0, 0, 0)) == 2)
    test.assert(dev_rtc.rtc_weekday(when(2000, 1, 1, 0, 0, 0)) == 6)
    test.assert(dev_rtc.rtc_weekday(when(2024, 2, 29, 0, 0, 0)) == 4)
    test.assert(dev_rtc.rtc_weekday(when(2023, 1, 1, 0, 0, 0)) == 7)
    // One date in every month of a year, so each month's term is used.
    let expected = [4, 7, 7, 3, 5, 1, 3, 6, 2, 4, 7, 2]
    for m in 1..13
        test.assert(dev_rtc.rtc_weekday(when(2026, m, 1, 0, 0, 0)) == expected[m - 1])

// ── Unix time ────────────────────────────────────────────────────────

@satisfies(REQ-DEV-006)
@test
fn test_unix_time_of_known_instants() [io]
    test.assert(dev_rtc.rtc_to_unix(when(1970, 1, 1, 0, 0, 0)) == Some(0))
    test.assert(dev_rtc.rtc_to_unix(when(2000, 1, 1, 0, 0, 0)) == Some(946684800))
    test.assert(dev_rtc.rtc_to_unix(when(2024, 2, 29, 12, 0, 0)) == Some(1709208000))
    test.assert(dev_rtc.rtc_to_unix(when(2038, 1, 19, 3, 14, 8)) == Some(2147483648))
    test.assert(dev_rtc.rtc_to_unix(when(2100, 3, 1, 0, 0, 0)) == Some(4107542400))
    test.assert(dev_rtc.rtc_to_unix(when(1969, 12, 31, 23, 59, 59)) == None)
    test.assert(dev_rtc.rtc_to_unix(when(2026, 2, 29, 0, 0, 0)) == None)

@satisfies(REQ-DEV-006)
@test
fn test_a_date_from_unix_time() [io]
    match dev_rtc.rtc_from_unix(1709208000)
        Some(t) =>
            test.assert(t.year == 2024)
            test.assert(t.month == 2)
            test.assert(t.day == 29)
            test.assert(t.hour == 12)
            test.assert(t.minute == 0)
        None    => test.assert(false)
    match dev_rtc.rtc_from_unix(2147483647)
        Some(t) =>
            test.assert(t.year == 2038)
            test.assert(t.month == 1)
            test.assert(t.day == 19)
            test.assert(t.hour == 3)
            test.assert(t.minute == 14)
            test.assert(t.second == 7)
        None    => test.assert(false)
    test.assert(dev_rtc.rtc_from_unix(-1) == None)

@satisfies(REQ-DEV-006)
@test
fn test_unix_time_round_trips() [io]
    // The first second of every month of a leap year and a common one,
    // and the last second of each year end.
    for y in [2024, 2026, 2100]
        for m in 1..13
            let t = when(y, m, 1, 0, 0, 0)
            match dev_rtc.rtc_to_unix(t)
                Some(u) =>
                    match dev_rtc.rtc_from_unix(u)
                        Some(b) =>
                            test.assert(b.year == y and b.month == m and b.day == 1)
                            match dev_rtc.rtc_from_unix(u - 1)
                                Some(p) => test.assert(p.second == 59 and p.minute == 59 and p.hour == 23)
                                None    => test.assert(false)
                        None    => test.assert(false)
                None    => test.assert(false)
